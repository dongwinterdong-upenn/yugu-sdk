{
  "name": "@shengzhiai/yugu-web-sdk",
  "version": "2.0.0",
  "description": "优谷雅言语音评测 PC Web SDK：整段评测、声通兼容评测、实时流式评测、语音合成、报告查询与浏览器录音",
  "keywords": [
    "yugu",
    "speech-evaluation",
    "pronunciation",
    "websocket",
    "tts",
    "sdk"
  ],
  "license": "Apache-2.0",
  "author": "优谷雅言 open.shengzhiai.com",
  "homepage": "https://open.shengzhiai.com/docs.html#sdk",
  "repository": {
    "type": "git",
    "url": "https://open.shengzhiai.com/git/yugu-sdk.git",
    "directory": "web"
  },
  "publishConfig": {
    "registry": "https://open.shengzhiai.com/npm/"
  },
  "type": "module",
  "main": "./dist/yugu-sdk.umd.js",
  "module": "./dist/yugu-sdk.mjs",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/yugu-sdk.umd.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/yugu-sdk.mjs",
      "require": "./dist/yugu-sdk.umd.js",
      "default": "./dist/yugu-sdk.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "pretest": "node scripts/build.mjs --quiet && node scripts/prepare-test-dirs.mjs",
    "test": "c8 --all --src src --include \"src/**/*.js\" --reporter=html --reporter=text-summary --reporter=json-summary --reporter=lcov --reports-dir=coverage --check-coverage --lines 70 node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml test/unit test/integration",
    "test:unit": "node --test test/unit",
    "test:integration": "node --test --test-concurrency=1 test/integration",
    "typecheck": "tsc -p types-test/tsconfig.json && tsc -p types-test/tsconfig.node.json && node scripts/check-types.mjs",
    "prepack": "node scripts/build.mjs --quiet"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "ws": "8.18.0"
  }
}

{
  "description": "优谷雅言语音评测微信小程序 SDK 示例",
  "compileType": "miniprogram",
  "libVersion": "3.0.0",
  "appid": "touristappid",
  "projectname": "yugu-miniprogram-demo",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": ".npmrc" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "ignoreUploadUnusedFiles": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
